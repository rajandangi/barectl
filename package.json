{
  "name": "barectl",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"static/**/*.css\" --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run deadcode",
    "audit:dependencies": "npm audit --audit-level=low",
    "deadcode": "knip"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
