{
  "name": "barectl",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"frontend/**/*.scss\" --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run deadcode",
    "audit:dependencies": "npm audit --audit-level=low",
    "deadcode": "knip"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@types/node": "24.19.0",
    "@uswds/uswds": "3.14.0",
    "eslint": "10.11.0",
    "htmx.org": "4.0.0",
    "knip": "6.38.0",
    "sass-embedded": "1.105.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1"
  }
}
