# Loaded explicitly with: uv run --env-file .env python manage.py runserver
BARECTL_DEBUG=1
BARECTL_SECRET_KEY=local-development-only-change-before-hosting
BARECTL_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional: the controller SSH configuration that supplies server aliases (default ~/.ssh/config).
# BARECTL_SSH_CONFIG=~/.ssh/config
# Optional during frontend development: load assets from `npm run dev`.
# BARECTL_VITE_DEV_SERVER_URL=http://localhost:5173
