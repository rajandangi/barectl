    "php_fpm": {
      "config_files": [
        "php.ini",
        "php-fpm.conf",
        "pools/<identifier>.conf",
        "pools/diagnostic.conf"
      ],
      "per_runtime": {
        "php84": {
          "app_socket": "/run/php-fpm/sites/<identifier>/php84/app.sock",
          "app_socket_mode": "0660",
          "config_directory": "/etc/php-fpm/sites/<identifier>/php84",
          "diagnostic_pool": "[diagnostic]\nuser = php-probe\ngroup = php-probe\nlisten = /run/php-fpm/sites/<identifier>/php84/diagnostic/listen.sock\nlisten.owner = root\nlisten.group = root\nlisten.mode = 0600\npm = static\npm.max_children = 1\nclear_env = yes\nsecurity.limit_extensions = .php\nphp_admin_value[session.save_path] = /var/lib/php-fpm/sites/<identifier>/php84/diagnostic/session\nphp_admin_value[upload_tmp_dir] = /var/lib/php-fpm/sites/<identifier>/php84/diagnostic/upload\nphp_admin_value[sys_temp_dir] = /var/lib/php-fpm/sites/<identifier>/php84/diagnostic/tmp\n",
          "diagnostic_socket": "/run/php-fpm/sites/<identifier>/php84/diagnostic/listen.sock",
          "diagnostic_socket_mode": "0600",
          "master_config": "[global]\ndaemonize = no\nerror_log = syslog\nprocess_control_timeout = 300s\ninclude = /etc/php-fpm/sites/<identifier>/php84/pools/*.conf\n",
          "service": "php-fpm-site-php84@<identifier>.service",
          "status_socket": "/run/php-fpm/sites/<identifier>/php84/status/listen.sock",
          "status_socket_mode": "0600",
          "unit": "[Unit]\nDescription=Independent php84 PHP service for %i\nAfter=network.target\n\n[Service]\nSlice=system.slice\nType=notify\nExecStartPre=/usr/bin/install -d -m 0700 /run/php-fpm/sites/%i/php84/status /run/php-fpm/sites/%i/php84/diagnostic\nExecStartPost=/usr/bin/chmod 0600 /run/php-fpm/sites/%i/php84/status/listen.sock\nExecStart=/nix/var/nix/profiles/barectl/php84/bin/php-fpm -F -y /etc/php-fpm/sites/%i/php84/php-fpm.conf -c /etc/php-fpm/sites/%i/php84/php.ini\nRuntimeDirectory=php-fpm/sites/%i/php84\nRuntimeDirectoryMode=0755\nKillSignal=SIGQUIT\nTimeoutStopSec=310s\nPrivateDevices=true\nPrivateTmp=true\nProtectSystem=full\nProtectHome=true\nRestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK\nRestart=on-failure\nUMask=0077\n\n[Install]\nWantedBy=multi-user.target\n",
          "unit_file": "/etc/systemd/system/php-fpm-site-php84@.service",
          "unit_mode": "0644"
        },
        "php85": {
          "app_socket": "/run/php-fpm/sites/<identifier>/php85/app.sock",
          "app_socket_mode": "0660",
          "config_directory": "/etc/php-fpm/sites/<identifier>/php85",
          "diagnostic_pool": "[diagnostic]\nuser = php-probe\ngroup = php-probe\nlisten = /run/php-fpm/sites/<identifier>/php85/diagnostic/listen.sock\nlisten.owner = root\nlisten.group = root\nlisten.mode = 0600\npm = static\npm.max_children = 1\nclear_env = yes\nsecurity.limit_extensions = .php\nphp_admin_value[session.save_path] = /var/lib/php-fpm/sites/<identifier>/php85/diagnostic/session\nphp_admin_value[upload_tmp_dir] = /var/lib/php-fpm/sites/<identifier>/php85/diagnostic/upload\nphp_admin_value[sys_temp_dir] = /var/lib/php-fpm/sites/<identifier>/php85/diagnostic/tmp\n",
          "diagnostic_socket": "/run/php-fpm/sites/<identifier>/php85/diagnostic/listen.sock",
          "diagnostic_socket_mode": "0600",
          "master_config": "[global]\ndaemonize = no\nerror_log = syslog\nprocess_control_timeout = 300s\ninclude = /etc/php-fpm/sites/<identifier>/php85/pools/*.conf\n",
          "service": "php-fpm-site-php85@<identifier>.service",
          "status_socket": "/run/php-fpm/sites/<identifier>/php85/status/listen.sock",
          "status_socket_mode": "0600",
          "unit": "[Unit]\nDescription=Independent php85 PHP service for %i\nAfter=network.target\n\n[Service]\nSlice=system.slice\nType=notify\nExecStartPre=/usr/bin/install -d -m 0700 /run/php-fpm/sites/%i/php85/status /run/php-fpm/sites/%i/php85/diagnostic\nExecStartPost=/usr/bin/chmod 0600 /run/php-fpm/sites/%i/php85/status/listen.sock\nExecStart=/nix/var/nix/profiles/barectl/php85/bin/php-fpm -F -y /etc/php-fpm/sites/%i/php85/php-fpm.conf -c /etc/php-fpm/sites/%i/php85/php.ini\nRuntimeDirectory=php-fpm/sites/%i/php85\nRuntimeDirectoryMode=0755\nKillSignal=SIGQUIT\nTimeoutStopSec=310s\nPrivateDevices=true\nPrivateTmp=true\nProtectSystem=full\nProtectHome=true\nRestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK\nRestart=on-failure\nUMask=0077\n\n[Install]\nWantedBy=multi-user.target\n",
          "unit_file": "/etc/systemd/system/php-fpm-site-php85@.service",
          "unit_mode": "0644"
        }
      },
      "runtimes": ["php84", "php85"],
      "service": "php-fpm-site-<runtime>@<identifier>.service"
    },
    "release": {
      "current": "/var/www/<identifier>/current",
      "current_owner": "root",
      "directory": "/var/www/<identifier>/releases",
