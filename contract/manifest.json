  "backups": {
    "capture": {
      "applications": ["plain", "wordpress", "laravel"],
      "database_name": "s<identifier>",
      "dump_filename": "s<identifier>.sql",
      "expected_parts": {
        "database": ["database"],
        "files": ["files"],
        "full": ["database", "files"]
      },
      "headroom_bytes": 1073741824,
      "identifier_pattern": "[a-z][a-z0-9]{2,23}",
      "marker": "barectl",
      "origins": ["manual", "scheduled", "safety"],
      "parts": ["database", "files"],
      "point_pattern": "[0-9a-f]{16}",
      "retention_days": [7, 14, 21, 30, 182],
      "scopes": ["database", "files", "full"],
      "tag_pattern": "[a-z0-9:_-]{1,48}",
      "tags": {
        "live": [
          "barectl",
          "site:<identifier>",
          "scope:<scope>",
          "part:<part>",
          "origin:<origin>",
          "capture:live",
          "point:<point>",
          "application:<application>",
          "complete"
        ],
        "paused": [
          "barectl",
          "site:<identifier>",
          "scope:<scope>",
          "part:<part>",
          "origin:<origin>",
          "capture:paused",
          "point:<point>",
          "application:<application>",
          "complete"
        ]
      }
    },
    "paths": {
      "key_root": "/etc/barectl/backups",
      "offsite": {
        "bucket_pattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]",
        "capture": "/etc/barectl/backups/offsite/capture.env",
        "config": "/etc/barectl/backups/offsite/config",
        "health": "_health",
        "health_repository": "s3:<endpoint>/<bucket>/<prefix>/_health",
        "prefix_pattern": "[a-z0-9][a-z0-9._-]{0,63}(?:/[a-z0-9][a-z0-9._-]{0,63}){0,3}",
        "provider_labels": {
          "r2": "Cloudflare R2",
          "s3": "Amazon S3"
        },
        "providers": ["s3", "r2"],
        "prune": "/etc/barectl/backups/offsite/prune.env",
        "region_pattern": "[a-z0-9-]{2,32}",
        "repository": "s3:<endpoint>/<bucket>/<prefix>/<identifier>",
        "root": "/etc/barectl/backups/offsite",
        "sources": "/etc/barectl/backups/offsite/sources"
      },
      "onsite": "/var/lib/barectl-backups/<identifier>/onsite",
      "repository_lock_root": "/run/lock/barectl",
      "repository_root": "/var/lib/barectl-backups",
      "server_key": "/etc/barectl/backups/<identifier>.key",
      "site": "/var/lib/barectl-backups/<identifier>"
    },
    "recovery_kit": {
      "fields": [
        "server_name",
        "identifier",
        "restic_version",
        "provider",
        "endpoint",
        "bucket",
        "prefix",
        "region",
        "sites"
      ]
    },
    "restic": {
      "binary": "/nix/var/nix/profiles/barectl/restic/bin/restic",
      "cache": "/var/cache/barectl/restic",
      "entry": "restic",
      "profile": "/nix/var/nix/profiles/barectl/restic",
      "profile_root": "/nix/var/nix/profiles/barectl"
    },
    "schedule": {
      "calendar": {
        "daily": "*-*-* 03:00:00 UTC",
        "weekly": "Mon *-*-* 03:00:00 UTC"
      },
      "frequencies": ["daily", "weekly"],
      "lock_wait_seconds": 30,
      "payload": "/etc/barectl/backups/schedule/<identifier>.json",
      "root": "/etc/barectl/backups/schedule",
      "run_timeout": "2h",
      "scopes": ["database", "files", "full"],
      "script": "/etc/barectl/backups/schedule/<identifier>.sh",
      "time_pattern": "([01][0-9]|2[0-3]):([0-5][0-9])\\Z",
      "units": {
        "service": {
          "contents": "[Unit]\nDescription=Barectl backup capture for <identifier>\nConditionPathIsDirectory=/var/www/<identifier>\n\n[Service]\nType=oneshot\nTimeoutStartSec=2h\nKillMode=control-group\nSlice=barectl-site-<identifier>-backup.slice\nExecStart=/bin/sh /etc/barectl/backups/schedule/<identifier>.sh /etc/barectl/backups/schedule/<identifier>.json\n",
          "file": "/etc/systemd/system/barectl-site-<identifier>-backup.service",
          "name": "barectl-site-<identifier>-backup.service"
        },
        "slice": {
          "contents": "[Unit]\nDescription=Barectl backups for <identifier>\n\n[Slice]\n",
          "file": "/etc/systemd/system/barectl-site-<identifier>-backup.slice",
          "name": "barectl-site-<identifier>-backup.slice"
        },
        "timer": {
          "contents": "[Unit]\nDescription=Barectl backup schedule for <identifier>\n\n[Timer]\nOnCalendar=*-*-* 03:00:00 UTC\nAccuracySec=1s\nRandomizedDelaySec=0\nPersistent=false\nDeferReactivation=yes\nUnit=barectl-site-<identifier>-backup.service\nSlice=barectl-site-<identifier>-backup.slice\n\n[Install]\nWantedBy=timers.target\n",
          "file": "/etc/systemd/system/barectl-site-<identifier>-backup.timer",
          "name": "barectl-site-<identifier>-backup.timer"
        }
      },
      "weekly_day": "Mon",
      "window_minutes": 60
    }
  },
  "foundation": {
    "caddy": {
      "admin_socket": "/run/caddy/admin.sock",
      "group": "caddy",
      "main_configuration": "{\n\tadmin unix//run/caddy/admin.sock|0600\n\tservers {\n\t\tstrict_sni_host on\n\t}\n}\nimport sites/*.caddy\n:80 {\n\trespond 404\n}",
      "main_file": "/etc/caddy/Caddyfile",
      "main_file_group": "root",
      "main_file_mode": "0644",
      "main_file_owner": "root",
      "sites_directory": "/etc/caddy/sites",
      "sites_directory_group": "root",
      "sites_directory_mode": "0755",
      "sites_directory_owner": "root",
      "state_directory": "/var/lib/caddy",
      "state_directory_mode": "0700",
      "unit": "[Unit]\nDescription=Caddy\nDocumentation=https://caddyserver.com/docs/\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=notify\nUser=caddy\nGroup=caddy\nExecStart=/nix/var/nix/profiles/barectl/caddy/bin/caddy run --environ --config /etc/caddy/Caddyfile --adapter caddyfile\nExecReload=/nix/var/nix/profiles/barectl/caddy/bin/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile --address unix//run/caddy/admin.sock\nTimeoutStopSec=5s\nLimitNOFILE=1048576\nPrivateTmp=true\nProtectSystem=full\nAmbientCapabilities=CAP_NET_BIND_SERVICE\nCapabilityBoundingSet=CAP_NET_BIND_SERVICE\nNoNewPrivileges=true\nUMask=0077\nRuntimeDirectory=caddy\nRuntimeDirectoryMode=0700\nStateDirectory=caddy\nStateDirectoryMode=0700\nRestart=on-failure\n\n[Install]\nWantedBy=multi-user.target",
      "unit_file": "/etc/systemd/system/caddy.service",
      "unit_file_mode": "0644",
      "user": "caddy"
    },
    "catalog_lock": {
      "architectures": ["x86_64-linux", "aarch64-linux"],
      "entry_pattern": "[a-z][a-z0-9_-]{0,31}",
      "format": 1,
      "kinds": ["php", "node", "tool", "extension"],
      "path": "runtimes/catalog_lock.json"
    },
    "journald": {
      "contents": "[Journal]\nStorage=persistent\n",
      "mode": "0644",
      "path": "/etc/systemd/journald.conf.d/50-barectl.conf",
      "retention": {
        "disk_cap_choices": ["250M", "500M", "1G", "2G", "4G"],
        "group": "root",
        "max_age_choices": ["1week", "1month", "3months", "6months", "1year"],
        "mode": "0644",
        "owner": "root",
        "path": "/etc/systemd/journald.conf.d/60-barectl-log-retention.conf",
        "shape": "[Journal]\nSystemMaxUse=<disk-cap>\nMaxRetentionSec=<max-age>\n"
      }
    },
    "native_execution": {
      "exit": {
        "engine": {
          "FAILED": 3,
          "LOCK_BUSY": 10,
          "PARTIAL": 2,
          "REFUSED": 1,
          "SUCCESS": 0
        },
        "probe": {
          "DRIFT": 15,
          "LOCK_CONFLICT": 10,
          "UNSAFE_LOCK": 11
        }
      },
      "limits": {
        "max_payload_bytes": 16384,
        "max_staged_body_bytes": 196608,
        "runtime_max": "30min",
        "timeout_stop_seconds": 60
      },
      "lock": {
        "directory": "/run/lock/barectl",
        "directory_mode": "0700",
        "file": "/run/lock/barectl/mutation.lock",
        "file_shape": "root-owned regular empty file with one link"
      },
      "stage_line_prefix": "barectl-stage ",
      "stages": ["preflight", "Nix", "catalog", "Caddy", "journald", "verify"],
      "systemd_run": "/usr/bin/systemd-run",
      "unit": {
        "pattern": "barectl-apply-[0-9a-f]{32}\\.service",
        "prefix": "barectl-apply-"
      }
    },
    "nix": {
      "catalog_entries": ["php84", "php85", "nodejs_22", "nodejs_24"],
      "config": {
        "mode": "0644",
        "path": "/etc/nix/nix.conf"
      },
      "profile_pattern": "/nix/var/nix/profiles/barectl/<entry>",
      "profile_root": "/nix/var/nix/profiles/barectl",
      "profiles": ["caddy", "composer", "wp-cli", "haproxy"]
    },
    "runtime_templates": {
      "master_unit": {
        "mode": "0644",
        "path": "/etc/systemd/system/php-fpm@.service",
        "template": "[Unit]\nDescription=PHP FastCGI Process Manager for %i\nAfter=network.target\n\n[Service]\nType=notify\nExecStart=/nix/var/nix/profiles/barectl/%i/bin/php-fpm -y /etc/php-fpm/%i/php-fpm.conf -c /etc/php-fpm/%i/php.ini\nExecReload=/bin/kill -USR2 $MAINPID\nRuntimeDirectory=php-fpm/%i\nRuntimeDirectoryMode=0755\nRuntimeDirectoryPreserve=yes\nPrivateDevices=true\nPrivateTmp=true\nProtectSystem=full\nProtectHome=true\nRestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK\nRestart=on-failure\nUMask=0077\n\n[Install]\nWantedBy=multi-user.target\n"
      },
      "site_php_units": {
        "/etc/systemd/system/php-fpm-site-php84@.service": {
          "mode": "0644",
          "template": "[Unit]\nDescription=Independent php84 PHP service for %i\nAfter=network.target\n\n[Service]\nSlice=system.slice\nType=notify\nExecStartPre=/usr/bin/install -d -m 0700 /run/php-fpm/sites/%i/php84/status /run/php-fpm/sites/%i/php84/diagnostic\nExecStartPost=/usr/bin/chmod 0600 /run/php-fpm/sites/%i/php84/status/listen.sock\nExecStart=/nix/var/nix/profiles/barectl/php84/bin/php-fpm -F -y /etc/php-fpm/sites/%i/php84/php-fpm.conf -c /etc/php-fpm/sites/%i/php84/php.ini\nRuntimeDirectory=php-fpm/sites/%i/php84\nRuntimeDirectoryMode=0755\nKillSignal=SIGQUIT\nTimeoutStopSec=310s\nPrivateDevices=true\nPrivateTmp=true\nProtectSystem=full\nProtectHome=true\nRestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK\nRestart=on-failure\nUMask=0077\n\n[Install]\nWantedBy=multi-user.target\n"
        },
        "/etc/systemd/system/php-fpm-site-php85@.service": {
          "mode": "0644",
          "template": "[Unit]\nDescription=Independent php85 PHP service for %i\nAfter=network.target\n\n[Service]\nSlice=system.slice\nType=notify\nExecStartPre=/usr/bin/install -d -m 0700 /run/php-fpm/sites/%i/php85/status /run/php-fpm/sites/%i/php85/diagnostic\nExecStartPost=/usr/bin/chmod 0600 /run/php-fpm/sites/%i/php85/status/listen.sock\nExecStart=/nix/var/nix/profiles/barectl/php85/bin/php-fpm -F -y /etc/php-fpm/sites/%i/php85/php-fpm.conf -c /etc/php-fpm/sites/%i/php85/php.ini\nRuntimeDirectory=php-fpm/sites/%i/php85\nRuntimeDirectoryMode=0755\nKillSignal=SIGQUIT\nTimeoutStopSec=310s\nPrivateDevices=true\nPrivateTmp=true\nProtectSystem=full\nProtectHome=true\nRestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK\nRestart=on-failure\nUMask=0077\n\n[Install]\nWantedBy=multi-user.target\n"
        }
      }
    }
  },
