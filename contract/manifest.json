  "site_convention": {
    "accounts": {
      "proxy": {
        "home": "/nonexistent",
        "name": "p<identifier>",
        "shell": "/usr/sbin/nologin"
      },
      "site": {
        "home": "/var/www/<identifier>",
        "name": "s<identifier>",
        "shell": "/usr/sbin/nologin",
        "supplementary_groups": []
      },
      "web": {
        "name": "caddy"
      }
    },
    "caddy": {
      "route": "<name> {\n    root * /var/www/<identifier>/current/public\n    encode zstd gzip\n    @hidden {\n        path_regexp hidden (^|/)\\.[^/]+\n        not path /.well-known/*\n    }\n    @wellknownhidden {\n        path_regexp wellknownhidden ^/\\.well-known/([^/]+/)*\\.[^/]+\n    }\n    @config path_regexp config (?i)(^|/)wp-config\\.php(/|$)\n    @uploads path_regexp uploads (?i)^/wp-content/uploads/.*\\.(php[0-9]*|phtml|phar)(/|$)\n    @php path_regexp php \\.php(/|$)\n    @index path /\n    route {\n        respond @hidden 404\n        respond @wellknownhidden 404\n        respond @config 404\n        respond @uploads 404\n        rewrite @index /index.php\n        reverse_proxy @php unix//run/haproxy/<identifier>/http.sock\n        file_server\n    }\n    log {\n        output file /var/www/<identifier>/logs/access.json {\n            roll_size 20MiB\n            roll_keep 5\n            roll_keep_for 14d\n        }\n        format filter {\n            wrap json\n            fields {\n                request>uri query {\n                    replace key REDACTED\n                    replace token REDACTED\n                    replace signature REDACTED\n                }\n            }\n        }\n    }\n}\n",
      "site_file": "/etc/caddy/sites/<identifier>.caddy",
      "site_file_group": "root",
      "site_file_mode": "0644",
      "site_file_owner": "root"
    },
    "haproxy": {
      "admin_socket": "/run/haproxy/<identifier>/admin.sock",
      "admin_socket_group": "root",
      "admin_socket_mode": "0600",
      "admin_socket_owner": "root",
      "config": "/etc/haproxy/sites/<identifier>.cfg",
      "config_mode": "0600",
      "config_template": "global\n    maxconn 64\n    user p<identifier>\n    group p<identifier>\n    nbthread 1\n    tune.quic.fe.sock-per-conn force-off\n    tune.quic.fe.tx.udp-gso off\n    tune.quic.be.tx.udp-gso off\n    server-state-file /var/lib/haproxy/sites/<identifier>.state\n    stats socket /run/haproxy/<identifier>/admin.sock uid 0 gid 0 mode 600 level admin\n    log /dev/log local0\n    log-tag haproxy-site-<identifier>\ndefaults\n    mode http\n    timeout connect 0\n    timeout client 0\n    timeout server 0\n    timeout queue 0\n    retry-on conn-failure\n    retries 2\nfcgi-app php\n    docroot /var/www/<identifier>/current/public\n    index index.php\n    path-info ^(/.+?\\.php)(/.*)?$\n    set-param HTTP_X_FORWARDED_URI %[req.hdr(X-Forwarded-Uri)]\n    set-param HTTPS %[var(txn.https)]\n    set-param SERVER_PORT %[dst_port]\n    no option keep-conn\nbackend php\n    use-fcgi-app php\n    balance roundrobin\n    load-server-state-from-file global\n    option redispatch\n    server php84 /run/php-fpm/sites/<identifier>/php84/app.sock proto fcgi id 1 maxconn 2 disabled\n    server php85 /run/php-fpm/sites/<identifier>/php85/app.sock proto fcgi id 2 maxconn 2 disabled\nfrontend incoming\n    bind /run/haproxy/<identifier>/http.sock user caddy group caddy mode 600\n    http-request del-header Proxy\n    http-request set-var(txn.https) str(on) if { req.hdr(X-Forwarded-Proto) -i https }\n    http-request set-var(txn.https) str(off) unless { var(txn.https) -m found }\n    default_backend php\n",
      "http_socket": "/run/haproxy/<identifier>/http.sock",
      "http_socket_group": "caddy",
      "http_socket_mode": "0600",
      "http_socket_owner": "caddy",
      "service": "haproxy-site@<identifier>.service",
      "state": "/var/lib/haproxy/sites/<identifier>.state",
      "state_mode": "0600",
      "unit": "[Unit]\nDescription=Private HTTP to FastCGI admission for %i\nAfter=network.target\n\n[Service]\nSlice=system.slice\nType=simple\nExecStart=/nix/var/nix/profiles/barectl/haproxy/bin/haproxy -f /etc/haproxy/sites/%i.cfg\nRuntimeDirectory=haproxy/%i\nRuntimeDirectoryMode=0755\nPrivateDevices=true\nPrivateTmp=true\nProtectSystem=full\nProtectHome=true\nRestrictAddressFamilies=AF_UNIX\nRestart=on-failure\nUMask=0077\n\n[Install]\nWantedBy=multi-user.target\n",
      "unit_file": "/etc/systemd/system/haproxy-site@.service",
      "unit_mode": "0644"
    },
    "identifier": {
      "label_pattern": "[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?",
      "max_name_octets": 253,
      "max_names": 10,
      "pattern": "[a-z][a-z0-9]{2,23}",
      "readiness_max_chars": 200,
      "readiness_pattern": "/(?:[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*)?",
      "reserved": [
        "acme",
        "admin",
        "apply",
        "backup",
        "barectl",
        "default",
        "diagnostic",
        "fpm",
        "html",
        "letsencrypt",
        "localhost",
        "nginx",
        "php",
        "repo",
        "root",
        "site",
        "www"
      ],
      "reserved_names": ["invalid", "localhost"],
      "system_accounts": [
        "saned",
        "sasl",
        "sddm",
        "sgx",
        "snmp",
        "squid",
        "sshd",
        "sssd",
        "statd",
        "stunnel4",
        "syslog"
      ]
    },
    "layout": [
      {
        "group": "root",
        "mode": "0755",
        "owner": "root",
        "path": "/var/www"
      },
      {
        "group": "root",
        "mode": "0755",
        "owner": "root",
