#!/bin/sh
# docs/quality.md#before-every-push
set -eu

if [ ! -f .env ]; then
    echo "pre-push: .env is missing. Configure it as the README describes." >&2
    exit 1
fi
if [ ! -d node_modules ]; then
    echo "pre-push: node_modules is missing. Run npm ci." >&2
    exit 1
fi

zero=0000000000000000000000000000000000000000
affecting=""
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" != "$zero" ] || continue
    if [ "$remote_sha" = "$zero" ]; then
        base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
    else
        base=$remote_sha
    fi
    [ -n "$base" ] || continue
    affecting="$affecting$(git diff --name-only --no-renames "$base" "$local_sha" 2>/dev/null |
        docker/disposable-server/native-paths.sh)"
done

echo "pre-push: development checks"
uv run ruff check .
uv run ruff format --check .
uv run --env-file .env mypy
uv run vulture
uv run djlint templates --lint --check
uv run --env-file .env python manage.py check --fail-level WARNING
uv run --env-file .env python manage.py makemigrations --check --dry-run
uv run --env-file .env python manage.py test --exclude-tag browser
npm run check

if [ -n "$affecting" ]; then
    echo "pre-push: native-affecting changes; after the push, run" \
        "docker/disposable-server/native-check.sh --env-file .env"
fi
