#!/bin/sh
# Barectl's local quality gate: the fast development and frontend checks, then discovery
# against a disposable server. Git runs it from the repository root before every push, and
# a failure aborts the push.
#
# Enable once per clone:      git config core.hooksPath .githooks
# Skip it in an emergency:    git push --no-verify
set -eu

if [ ! -f .env ]; then
    echo "pre-push: .env is missing. Configure it as the README describes." >&2
    exit 1
fi
if [ ! -d node_modules ]; then
    echo "pre-push: node_modules is missing. Run npm ci." >&2
    exit 1
fi
if ! docker info >/dev/null 2>&1; then
    echo "pre-push: Docker is not running; the disposable-server tests need it." >&2
    exit 1
fi

echo "pre-push: development checks"
uv run ruff check .
uv run ruff format --check .
uv run --env-file .env mypy
uv run vulture
uv run djlint templates --lint --check
uv run --env-file .env python manage.py check --fail-level WARNING
uv run --env-file .env python manage.py makemigrations --check --dry-run
uv run --env-file .env python manage.py test --exclude-tag browser
npm run check
# The disposable-server tests include one browser journey against the production build.
npm run build

echo "pre-push: disposable-server tests"
docker/disposable-server/run-tests.sh --env-file .env
